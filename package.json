{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oc-tps",
  "version": "0.0.11",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tarquinen/oc-tps"
  },
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser --preload @opentui/solid/preload"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.10"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.10",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "assets/",
    "README.md",
    "dist/"
  ]
}
