{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["bun", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.ts", "*.tsx", "scripts/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
}
